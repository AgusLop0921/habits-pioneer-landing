---
import { STORE } from '../data/config';
import { STR, type Locale } from '../data/strings';
interface Props {
  lang: Locale;
  variant?: 'hero' | 'final';
}
const { lang, variant = 'hero' } = Astro.props;
const t = STR[lang];
---

<div class={`store-row ${variant}`}>
  <a class="store-btn apple" href={STORE.apple} rel="noopener">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
      ><path
        d="M16.4 12.7c0-2.4 2-3.6 2.1-3.6-1.1-1.7-2.9-1.9-3.6-1.9-1.5-.2-3 .9-3.7.9-.8 0-1.9-.9-3.2-.9-1.6 0-3.1 1-3.9 2.4-1.7 2.9-.4 7.2 1.2 9.6.8 1.2 1.7 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.5-1-2.5-3.7zM14 5.6c.7-.8 1.1-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z"
      ></path></svg
    >
    <span class="store-lbl"><small>{t.storeApplePre}&#32;</small><strong>App Store</strong></span>
  </a>
  <a class="store-btn google" href={STORE.google} rel="noopener">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"
      ><path d="M3.6 2.3c-.3.3-.5.8-.5 1.4v16.6c0 .6.2 1.1.5 1.4l8.7-9.7L3.6 2.3z" fill="#7C5CFC"
      ></path><path d="M15.9 8.5 12.3 12l3.6 3.5 4.2-2.4c.8-.5.8-1.7 0-2.2l-4.2-2.4z" fill="#E5A03C"
      ></path><path d="m12.3 12-8.7 9.7c.4.4 1 .5 1.7.1l10.6-6.3L12.3 12z" fill="#DE7358"></path><path
        d="M5.3 2.2c-.7-.4-1.3-.3-1.7.1l8.7 9.7 3.6-3.5L5.3 2.2z"
        fill="#4CAF7D"></path></svg
    >
    <span class="store-lbl"><small>{t.storeGooglePre}&#32;</small><strong>Google Play</strong></span>
  </a>
</div>

<style>
  .store-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .store-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    border-radius: 16px;
    transition:
      background 0.16s ease,
      border-color 0.16s ease;
  }
  .store-row.final .store-btn {
    padding: 15px 24px;
  }
  .store-btn.apple {
    background: var(--ink);
    color: var(--bg);
  }
  .store-btn.apple:hover {
    background: #2b2320;
    color: var(--bg);
  }
  .store-btn.google {
    background: #fff;
    color: var(--ink);
    border: 1px solid var(--border-btn);
  }
  .store-row.final .store-btn.google {
    background: var(--bg);
  }
  .store-btn.google:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .store-lbl {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    text-align: left;
  }
  .store-lbl small {
    font-size: 10.5px;
    opacity: 0.7;
  }
  .store-btn.google .store-lbl small {
    color: var(--muted-2);
    opacity: 1;
  }
  .store-lbl strong {
    font-family: var(--font-head);
    font-size: 15.5px;
    font-weight: 500;
  }
</style>
