---
/**
 * Three-stone brand mark. Drawn as inline SVG so it can animate.
 * viewBox 0 0 60 68. Base stone color depends on the background it sits on.
 */
interface Props {
  width?: number;
  /** base (bottom) stone color — #CDC3B4 on cream, #F0EBE3 on dark */
  base?: string;
  /** gentle idle bob on the top two stones (header) */
  idle?: boolean;
  class?: string;
}
const { width = 26, base = '#CDC3B4', idle = false, class: cls = '' } = Astro.props;
const height = Math.round((width * 68) / 60);
---

<svg
  width={width}
  height={height}
  viewBox="0 0 60 68"
  class={`stone-logo ${idle ? 'idle' : ''} ${cls}`}
  aria-hidden="true"
  focusable="false"
>
  <ellipse class="s-top" cx="30" cy="20" rx="14" ry="9" fill="#DE7358"></ellipse>
  <ellipse class="s-mid" cx="30" cy="35" rx="20" ry="11" fill="#E5A03C"></ellipse>
  <ellipse cx="30" cy="53" rx="26" ry="13" fill={base}></ellipse>
</svg>

<style>
  .stone-logo .s-top,
  .stone-logo .s-mid {
    transform-origin: center;
  }
  .stone-logo.idle .s-top {
    animation: bob 5.5s ease-in-out infinite;
    transform-origin: 30px 20px;
  }
  .stone-logo.idle .s-mid {
    animation: bob2 5.5s ease-in-out 0.35s infinite;
    transform-origin: 30px 35px;
  }
</style>
